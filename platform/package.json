{
  "name": "berelax-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter api start:dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --no-bail test",
    "test:e2e": "pnpm --filter api test:e2e",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api prisma:seed",
    "db:reset": "pnpm --filter api prisma:reset",
    "db:verify": "pnpm --filter api db:verify",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcrypt"
    ]
  }
}
