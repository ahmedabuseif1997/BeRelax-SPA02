# The NestJS API, including its global /v1 prefix (apps/api/src/main.ts).
# Read in the browser, so it must be NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:3000/v1

# The API's CORS allow-list must contain this app's origin, and its refresh
# cookie (brx_rt: HttpOnly, SameSite=Strict, domain COOKIE_DOMAIN) must be
# sent to it — so in development run both on localhost:
#   apps/api  .env   DASHBOARD_ORIGIN=http://localhost:3001
#                    COOKIE_DOMAIN=localhost
