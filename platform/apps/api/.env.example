# Copy to .env and fill in. NEVER commit .env — this file carries names, never values.

# ── Database ──────────────────────────────────────────────────────────────
# Supabase gives you TWO connection strings and using the wrong one costs an
# afternoon. DATABASE_URL is the transaction-mode pooler (PgBouncer, port 6543);
# DIRECT_URL is the session connection (port 5432) that `prisma migrate` needs,
# because PgBouncer in transaction mode supports neither prepared statements nor
# session-level advisory locks.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Local development with docker compose:
# DATABASE_URL="postgresql://postgres:dev@localhost:5432/berelax"
# DIRECT_URL="postgresql://postgres:dev@localhost:5432/berelax"

# ── Auth ──────────────────────────────────────────────────────────────────
# 32 random bytes:  openssl rand -base64 32
JWT_SECRET=""
# Set ONLY during a secret rotation, for a 24-hour overlap window. Then remove.
JWT_SECRET_PREVIOUS=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7
BCRYPT_COST=12

# ── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_BASE_URL="http://localhost:3000"
DASHBOARD_ORIGIN="http://localhost:3001"
PUBLIC_SITE_ORIGIN="http://localhost:8080"

# The attribution cookie mirror only works if the API is a SUBDOMAIN of the
# public site — api.berelax.ae alongside berelax.ae. On a different domain the
# cookie is third-party and Safari blocks it outright. See spec §10.5.
COOKIE_DOMAIN="localhost"

DEFAULT_BRANCH_ID=""

# ── Business ──────────────────────────────────────────────────────────────
# Store UTC, render Dubai. Leave TZ=UTC: business_day() handles the conversion.
TZ=UTC
WHATSAPP_NUMBER="971525108633"

# ── Compliance ────────────────────────────────────────────────────────────
ATTRIBUTION_RETENTION_DAYS=90
GUEST_RETENTION_YEARS=3
FINANCIAL_RETENTION_YEARS=5
# 32 random bytes. NEVER rotate this: rotation orphans every already-erased
# guest record, because the phone hash would no longer match.
ERASURE_SALT=""

# ── Ops ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=""
IDEMPOTENCY_TTL_HOURS=24

# ── Parallel pilot (Phase 7) ──────────────────────────────────────────────
# How far the counted cash drawer may differ from the system before the night
# is called mismatched. Zero on purpose: a variance is a finding to chase, not
# a rounding allowance.
RECONCILIATION_CASH_TOLERANCE_FILS=0
